                    "textStyle": {
                      "fontFamily": "Arial"
                    }
                  },
                  {
                    "value": "This Power BI Style Guide and UI Kit is designed to provide a consistent framework for building professional and visually cohesive dashboards. It  establishes standardized design elements including colors, typography, layouts, icons, navigation patterns, and visual components.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\tThe goal of this guide is to ensure that all Power BI reports follow a unified design language, improving readability, usability, and user experience across the organization. By using these predefined styles and components, report developers can create dashboards that are both visually appealing and easy to maintain.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\tThis style guide serves as a central reference for report designers, analysts, and developers to maintain consistency in branding, spacing, alignment, and visual hierarchy when creating Power BI reports.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "12pt"
                    }
                  }
                ]
              }
            ]
          }
