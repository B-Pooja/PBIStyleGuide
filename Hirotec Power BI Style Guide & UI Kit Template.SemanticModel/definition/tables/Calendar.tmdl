		isNameInferred
		sourceColumn: [Datekey]

		variation Variation
			isDefault
			relationship: 2fe288bf-36f5-4a6c-838a-9f149bfdf33c
			defaultHierarchy: LocalDateTable_4942c080-7051-451a-a6a3-a5524b4716ae.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2010, 1, 1),
				        DATE(2020, 12, 31)
				    ),
				    "Year", YEAR([Date]),
				    "Datekey", FORMAT([Date], "MM/DD/YYYY"),
				    "Month No", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day Name", FORMAT([Date], "DDD"),
				    "Weekday No", WEEKDAY([Date], 2)
				)

	annotation PBI_Id = 4cc7b90459224c4481d70b84cba7fde4

